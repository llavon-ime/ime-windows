<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1" CornerRadius="8" Padding="4" TabFocusNavigation="Cycle">
  <Button x:Name="OpenSettingsButton" AutomationProperties.Name="設定"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Center" Height="42" Padding="12,0"
          Background="Transparent" BorderThickness="0" CornerRadius="4">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="16" Width="28" HorizontalAlignment="Left" />
      <TextBlock Text="設定" FontFamily="Microsoft JhengHei UI" FontSize="14"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Button>
</Border>
