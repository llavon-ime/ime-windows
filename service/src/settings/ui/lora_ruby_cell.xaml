<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="40" MinHeight="46">
  <Grid.RowDefinitions>
    <RowDefinition Height="17"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="Reading" Grid.Row="0" FontSize="8"
             FontFamily="Microsoft JhengHei UI" TextAlignment="Center"
             TextTrimming="None" VerticalAlignment="Bottom"/>
  <TextBlock x:Name="Character" Grid.Row="1" FontSize="21" TextAlignment="Center"
             VerticalAlignment="Top"/>
</Grid>
