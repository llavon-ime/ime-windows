<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
      TabFocusNavigation="Cycle">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Center" Padding="28,24,28,40" Spacing="0">
      <TextBlock Text="模型檔案" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="8" Margin="0,0,0,24">
        <TextBlock Text="指定要載入的 GGUF 模型檔案。" FontSize="14" TextWrapping="Wrap" />
        <Grid MaxWidth="600" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ModelPath" Grid.Column="0" PlaceholderText="選擇 .gguf 模型檔案" MinHeight="32" FontSize="14" />
          <Button x:Name="BrowseModelButton" Grid.Column="2" Content="瀏覽…" MinWidth="88" MinHeight="32" FontSize="14" />
        </Grid>
        <Grid MaxWidth="600" HorizontalAlignment="Stretch">
          <Button x:Name="SaveModelButton" Style="{StaticResource AccentButtonStyle}" Content="套用模型" MinWidth="112" MinHeight="32" FontSize="14" HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="ModelNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>

      <TextBlock Text="推論裝置" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="8" Margin="0,0,0,24">
        <Grid x:Name="ActiveDeviceRow" MaxWidth="540" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ActiveDeviceStatus" Grid.Column="0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock x:Name="ActiveBackend" Grid.Column="1" FontSize="12" Margin="16,2,0,0" />
        </Grid>
        <TextBlock Text="下次啟動設定" FontSize="14" />
        <ComboBox x:Name="InferenceDevice" MaxWidth="540" MinHeight="32" FontSize="14" HorizontalAlignment="Stretch" />
        <Grid MaxWidth="540" HorizontalAlignment="Stretch">
          <Button x:Name="SaveInferenceButton" Style="{StaticResource AccentButtonStyle}" Content="儲存裝置設定" MinWidth="132" MinHeight="32" FontSize="14" HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="InferenceNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>

      <TextBlock Text="輸入設定" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="8" Margin="0,0,0,24">
        <ToggleSwitch x:Name="FullWidthToggle" Header="使用 Shift + 空格鍵切換字元寬度" OnContent="開啟" OffContent="關閉" />
        <TextBlock x:Name="FullWidthNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>

      <TextBlock Text="自訂名字" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="10" Margin="0,0,0,24">
        <Grid MaxWidth="600" HorizontalAlignment="Stretch">
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
          <TextBlock Text="名字" Grid.Column="0" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="注音" Grid.Column="2" FontSize="12" FontWeight="SemiBold" />
        </Grid>
        <StackPanel x:Name="CustomNamesPanel" Spacing="8" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="AddCustomNameButton" Content="＋ 新增名字" MinWidth="120" MinHeight="32" FontSize="14" />
          <Button x:Name="SaveCustomNamesButton" Style="{StaticResource AccentButtonStyle}" Content="儲存自訂名字" MinWidth="132" MinHeight="32" FontSize="14" IsEnabled="False" />
        </StackPanel>
        <TextBlock x:Name="CustomNamesNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>

      <TextBlock Text="LoRA 個人化模型" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="8" Margin="0,0,0,24">
        <TextBlock Text="檢查尚未訓練的輸入紀錄，選擇要用於本機微調的資料。取消勾選的紀錄會標記為已排除。" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="PendingSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox x:Name="EncryptedRecording" Content="啟用加密記錄" IsChecked="False" />
          <TextBlock x:Name="PasswordStatus" Text="密碼未設定" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="LoraButton" Content="使用我的輸入改進模型" MinWidth="196" MinHeight="32" FontSize="14" HorizontalAlignment="Left" />
        <TextBlock x:Name="LoraNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>

      <TextBlock Text="軟體更新" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18" />
      <StackPanel Spacing="8" Margin="0,0,0,24">
        <TextBlock x:Name="BuildLabel" FontSize="14" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="UpdateButton" Content="檢查更新" MinWidth="112" MinHeight="32" FontSize="14" />
          <HyperlinkButton x:Name="UpdateDownload" Visibility="Collapsed" MinHeight="32" FontSize="14" />
        </StackPanel>
        <TextBlock x:Name="UpdateStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="開啟設定時會自動與 latest 建置比較。" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
