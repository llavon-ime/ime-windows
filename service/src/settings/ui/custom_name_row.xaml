<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="600" MinHeight="64" HorizontalAlignment="Left">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="180"/><ColumnDefinition Width="12"/>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
    <ColumnDefinition Width="84"/>
  </Grid.ColumnDefinitions>
  <TextBox x:Name="Name" Grid.Column="0" PlaceholderText="例如：王小明"
           MinHeight="32" FontSize="14" VerticalAlignment="Bottom"
           AutomationProperties.Name="自訂名字"/>
  <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                AutomationProperties.Name="名字對應注音">
    <StackPanel x:Name="Pronunciations" Orientation="Horizontal" Spacing="8"/>
  </ScrollViewer>
  <Button x:Name="RemoveButton" Grid.Column="4" Content="移除"
          MinWidth="84" MinHeight="32" FontSize="14"
          VerticalAlignment="Bottom" AutomationProperties.Name="移除這個自訂名字"/>
</Grid>
