<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#66000000" TabFocusNavigation="Cycle">
  <Border x:Name="DialogCard" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="8" Width="530" MaxHeight="700" Margin="16" VerticalAlignment="Stretch"
          HorizontalAlignment="Center" BorderThickness="1" Padding="24,20,24,16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="DialogTitle" Text="訓練個人化模型" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <ContentControl x:Name="DialogContent" Grid.Row="1">
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel Width="480" Spacing="16">
      <TextBlock Text="基礎模型&#10;tony65535/llavon-ime-llama-250m · 約 1 GB · CC-BY-NC-4.0"
                 FontSize="12" TextWrapping="Wrap" />
      <Border x:Name="ModelStatusBorder" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <FontIcon x:Name="ModelStatusIcon" Grid.Column="0" FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    VerticalAlignment="Top" Margin="0,3,0,0"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="ModelStatusTitle" Text="尚未下載" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ModelStatusDetail" Text="下載模型後才能開始訓練。" FontSize="12" TextWrapping="Wrap"/>
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CheckModelButton" Content="檢查更新" MinHeight="32"/>
          <Button x:Name="DownloadModelButton" Content="下載模型" MinHeight="32"/>
          <Button x:Name="CancelModelButton" Content="取消下載" MinHeight="32" Visibility="Collapsed"/>
        </StackPanel>
        <Button x:Name="TrainingHistoryButton" Grid.Column="1" Content="訓練歷程" MinHeight="32"/>
      </Grid>
      <StackPanel Spacing="8">
        <TextBlock Text="LoRA 訓練器" FontSize="14" FontWeight="SemiBold"/>
        <Border Padding="0,4,0,12" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"
                      FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Top" Margin="0,3,0,0"/>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock x:Name="TrainerStatusTitle" Text="正在確認安裝狀態" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="TrainerStatusDetail" Text="" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock x:Name="TrainerReleaseDetail" Text="" FontSize="12" TextWrapping="Wrap"/>
              <ProgressBar x:Name="TrainerProgress" Minimum="0" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="TrainerBackend" Width="150" MinHeight="32" Header="下載版本">
            <ComboBoxItem Content="CPU"/>
            <ComboBoxItem Content="CUDA"/>
            <ComboBoxItem Content="ROCm"/>
          </ComboBox>
          <Button x:Name="CheckTrainerButton" Content="檢查版本" MinHeight="32" VerticalAlignment="Bottom"/>
          <Button x:Name="InstallTrainerButton" Content="下載訓練器" MinHeight="32" VerticalAlignment="Bottom"/>
          <Button x:Name="CancelTrainerButton" Content="取消" MinHeight="32" VerticalAlignment="Bottom" Visibility="Collapsed"/>
        </StackPanel>
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="訓練資料" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="TrainingSummary" Text="共 0 筆" FontSize="12"/>
        </StackPanel>
        <Button x:Name="TrainingDataButton" Grid.Column="1" Content="檢視訓練資料" MinHeight="32" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock x:Name="EmptyTrainingItems" Text="目前沒有尚未訓練的資料。請先使用輸入法提交一些文字。"
                 FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"/>
      <TextBlock Text="訓練設定" FontSize="14" FontWeight="SemiBold"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="LoRA rank" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="Rank" Grid.Row="0" Grid.Column="1" Text="8" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="LoRA alpha" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="Alpha" Grid.Row="1" Grid.Column="1" Text="16" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="LoRA dropout" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="Dropout" Grid.Row="2" Grid.Column="1" Text="0" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch size" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="BatchSize" Grid.Row="3" Grid.Column="1" Text="1" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Gradient accumulation" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="GradientAccumulation" Grid.Row="4" Grid.Column="1" Text="1" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="5" Grid.Column="0" Text="Epochs" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="Epochs" Grid.Row="5" Grid.Column="1" Text="5" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="6" Grid.Column="0" Text="Max steps" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="MaxSteps" Grid.Row="6" Grid.Column="1" Text="-1" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="7" Grid.Column="0" Text="Learning rate" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="LearningRate" Grid.Row="7" Grid.Column="1" Text="0.0001" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="8" Grid.Column="0" Text="Weight decay" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="WeightDecay" Grid.Row="8" Grid.Column="1" Text="0" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="9" Grid.Column="0" Text="Warmup steps" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="WarmupSteps" Grid.Row="9" Grid.Column="1" Text="0" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="10" Grid.Column="0" Text="Max gradient norm" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="MaxGradientNorm" Grid.Row="10" Grid.Column="1" Text="1" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="11" Grid.Column="0" Text="Save every" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="SaveEvery" Grid.Row="11" Grid.Column="1" Text="0" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="12" Grid.Column="0" Text="Seed" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="Seed" Grid.Row="12" Grid.Column="1" Text="42" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="13" Grid.Column="0" Text="Max sequence length" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="MaxSequenceLength" Grid.Row="13" Grid.Column="1" Text="384" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
      <TextBlock Grid.Row="14" Grid.Column="0" Text="Target modules" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4" />
      <TextBox x:Name="TargetModules" Grid.Row="14" Grid.Column="1" Text="q_proj,v_proj" Width="220" MinHeight="32" HorizontalAlignment="Left" Margin="0,2,0,2" />
        <TextBlock Grid.Row="15" Grid.Column="0" Text="Device" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4"/>
        <ComboBox x:Name="Device" Grid.Row="15" Grid.Column="1" MinHeight="32" Width="220" HorizontalAlignment="Left" Margin="0,2,0,2">
          <ComboBoxItem Content="auto"/><ComboBoxItem Content="cuda"/><ComboBoxItem Content="cpu"/>
        </ComboBox>
        <TextBlock Grid.Row="16" Grid.Column="0" Text="DType" FontSize="12" VerticalAlignment="Center" Margin="0,4,0,4"/>
        <ComboBox x:Name="DType" Grid.Row="16" Grid.Column="1" MinHeight="32" Width="220" HorizontalAlignment="Left" Margin="0,2,0,2">
          <ComboBoxItem Content="float32"/><ComboBoxItem Content="bfloat16"/>
        </ComboBox>
      </Grid>
      <ToggleSwitch x:Name="Shuffle" Header="Shuffle training data" IsOn="True"/>
      <ProgressBar x:Name="TrainingProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" Text="所有欄位都已填入建議預設值。" FontSize="12" TextWrapping="Wrap"/>
      <Button x:Name="ReloadModelButton" Content="立即套用" MinHeight="32"
              HorizontalAlignment="Left" Visibility="Collapsed"/>
      <TextBlock x:Name="EstimatedSteps" Text="預計 steps：0" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
        </ScrollViewer>
      </ContentControl>
      <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="DialogPrimaryButton" Style="{StaticResource AccentButtonStyle}" Grid.Column="0" Content="開始訓練" MinHeight="32"
                HorizontalAlignment="Stretch" IsEnabled="False"/>
        <Button x:Name="DialogSecondaryButton" Grid.Column="1" Content="關閉" MinHeight="32"
                HorizontalAlignment="Stretch"/>
      </Grid>
    </Grid>
  </Border>
</Grid>
