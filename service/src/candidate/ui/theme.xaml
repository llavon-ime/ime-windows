<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="CandidateBorderBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="CandidateSelectionBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="CandidateAccentBrush" Color="#0066D6" />
      <SolidColorBrush x:Key="CandidateTextBrush" Color="#212121" />
      <SolidColorBrush x:Key="CandidateSelectedTextBrush" Color="#212121" />
      <SolidColorBrush x:Key="CandidateSelectedNumberBrush" Color="#606060" />
      <SolidColorBrush x:Key="CandidateSecondaryTextBrush" Color="#606060" />
      <SolidColorBrush x:Key="CandidateDisabledTextBrush" Color="#AAAAAA" />
      <SolidColorBrush x:Key="CandidateDividerBrush" Color="#E8E8E8" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="CandidateBorderBrush" Color="#454545" />
      <SolidColorBrush x:Key="CandidateSelectionBrush" Color="#3C3C3C" />
      <SolidColorBrush x:Key="CandidateAccentBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="CandidateTextBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="CandidateSelectedTextBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="CandidateSelectedNumberBrush" Color="#CFCFCF" />
      <SolidColorBrush x:Key="CandidateSecondaryTextBrush" Color="#CFCFCF" />
      <SolidColorBrush x:Key="CandidateDisabledTextBrush" Color="#7A7A7A" />
      <SolidColorBrush x:Key="CandidateDividerBrush" Color="#484848" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="CandidateSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CandidateBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="CandidateSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="CandidateAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="CandidateTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="CandidateSelectedTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="CandidateSelectedNumberBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="CandidateSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="CandidateDisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="CandidateDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="CandidateTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Microsoft JhengHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{ThemeResource CandidateTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="CandidateSelectedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CandidateTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CandidateSelectedTextBrush}" />
  </Style>
  <Style x:Key="CandidateNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource CandidateTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CandidateSecondaryTextBrush}" />
  </Style>
  <Style x:Key="CandidateSelectedNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource CandidateTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CandidateSelectedNumberBrush}" />
  </Style>
  <Style x:Key="CandidateColumnStyle" TargetType="StackPanel">
    <Setter Property="Width" Value="98" />
  </Style>
  <Style x:Key="CandidateExpandedColumnStyle" TargetType="StackPanel">
    <Setter Property="Width" Value="84" />
  </Style>
</ResourceDictionary>
