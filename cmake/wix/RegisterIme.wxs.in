<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <!--
      This helper is embedded in the MSI so the first upgrade from an older
      release can stop its service and unload its DLL before InstallFiles runs.
      As an immediate, impersonated action it executes on the interactive
      user's desktop, which is the scope required by TF_IPPMF_FORSESSION.
    -->
    <Binary
      Id="LlavonImeLifecycleHelper"
      SourceFile="@LLAVON_IME_LIFECYCLE_HELPER_WIX_PATH@" />
    <CustomAction
      Id="ReleaseLlavonImeForUpgrade"
      BinaryRef="LlavonImeLifecycleHelper"
      ExeCommand="prepare-update &quot;[INSTALL_ROOT]bin\llavon-ime-service.exe&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="ReleaseLlavonImeForUninstall"
      BinaryRef="LlavonImeLifecycleHelper"
      ExeCommand="prepare-uninstall &quot;[INSTALL_ROOT]bin\llavon-ime-service.exe&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction
      Id="RegisterLlavonIme"
      Directory="INSTALL_ROOT"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALL_ROOT]bin\llavon-ime.dll&quot;" />
    <CustomAction
      Id="UnregisterLlavonIme"
      Directory="INSTALL_ROOT"
      Execute="deferred"
      Impersonate="no"
      Return="ignore"
      ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /u /s &quot;[INSTALL_ROOT]bin\llavon-ime.dll&quot;" />
    <CustomAction
      Id="RestartLlavonImeService"
      Directory="INSTALL_ROOT"
      ExeCommand="&quot;[SystemFolder]wscript.exe&quot; &quot;[INSTALL_ROOT]bin\start-llavon-ime-service.vbs&quot;"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="ReleaseLlavonImeForUpgrade" After="InstallValidate"
              Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="ReleaseLlavonImeForUninstall" After="ReleaseLlavonImeForUpgrade"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RegisterLlavonIme" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnregisterLlavonIme" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RestartLlavonImeService" After="InstallFinalize"
              Condition="WIX_UPGRADE_DETECTED AND NOT REMOVE" />
    </InstallExecuteSequence>
  </CPackWiXFragment>
</CPackWiXPatch>
