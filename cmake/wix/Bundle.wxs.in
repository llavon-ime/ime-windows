<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
      Name="Llavon IME"
      Manufacturer="Llavon IME"
      Version="@LLAVON_IME_VERSION@"
      UpgradeCode="7E4C5A19-9882-4E30-8747-3D1649D13257"
      Compressed="yes">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseUrl=""
          Theme="hyperlinkLargeLicense"
          ThemeFile="@LLAVON_IME_SOURCE_DIR@/cmake/wix/BundleTheme.xml"
          LocalizationFile="@LLAVON_IME_SOURCE_DIR@/cmake/wix/BundleTheme.zh-TW.wxl"
          ShowVersion="yes"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <!-- Re-run on setup upgrades; the helper verifies and reuses the cached GGUF. -->
      <ExePackage
          Id="LlavonModelDownload"
          DisplayName="拉風輸入法模型"
          SourceFile="@LLAVON_IME_MODEL_INSTALLER_PATH@"
          Compressed="yes"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="--install-model @LLAVON_IME_MODEL_REVISION@ @LLAVON_IME_MODEL_SHA256@ @LLAVON_IME_MODEL_SIZE@" />

      <!-- Keep using the installer when loaded TSF DLLs must be replaced at reboot. -->
      <MsiPackage
          Id="LlavonImeMsi"
          SourceFile="@LLAVON_IME_MSI_PATH@"
          Compressed="yes"
          Visible="no"
          bal:DisplayFilesInUseDialogCondition="0">
        <!-- Detect locked TSF DLLs with Restart Manager, but do not shut down
             unrelated apps such as browsers or document editors. -->
        <MsiProperty Name="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
      </MsiPackage>

    </Chain>
  </Bundle>
</Wix>
