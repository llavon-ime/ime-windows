<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="LlavonImeProgramMenuFolder" Name="Llavon IME" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALL_ROOT">
      <Component Id="LlavonImeUninstallShortcut" Guid="*">
        <Shortcut
          Id="OpenLlavonImeSettings"
          Directory="LlavonImeProgramMenuFolder"
          Name="拉風輸入法設定"
          Description="開啟拉風輸入法設定"
          Target="[INSTALL_ROOT]bin\llavon-ime-service.exe"
          Arguments="--settings">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Llavon.IME.Windows" />
        </Shortcut>
        <Shortcut
          Id="UninstallLlavonImeFromInstallDirectory"
          Name="解除安裝拉風輸入法"
          Description="開啟已安裝的程式，解除安裝 Llavon IME 安裝套件"
          Target="[SystemFolder]control.exe"
          Arguments="appwiz.cpl" />
        <Shortcut
          Id="UninstallLlavonImeFromProgramMenu"
          Directory="LlavonImeProgramMenuFolder"
          Name="解除安裝拉風輸入法"
          Description="開啟已安裝的程式，解除安裝 Llavon IME 安裝套件"
          Target="[SystemFolder]control.exe"
          Arguments="appwiz.cpl" />
        <RemoveFolder
          Id="RemoveLlavonImeProgramMenuFolder"
          Directory="LlavonImeProgramMenuFolder"
          On="uninstall" />

        <!--
          Windows Installer normally removes only files tracked by the MSI.
          Also remove files left by older builds or runtime diagnostics from
          the known installation tree, then remove the directories bottom-up.
        -->
        <RemoveFile Id="RemoveLlavonImeRootFiles" Directory="INSTALL_ROOT" Name="*" On="uninstall" />
        <RemoveFile Id="RemoveLlavonImeBinFiles" Directory="CM_DP_Runtime.bin" Name="*" On="uninstall" />
        <RemoveFile Id="RemoveLlavonImeTableFiles" Directory="CM_DP_Runtime.tables" Name="*" On="uninstall" />
        <RemoveFile Id="RemoveLlavonImeTokenFiles" Directory="CM_DP_Runtime.tables.tokens" Name="*" On="uninstall" />
        <RemoveFile Id="RemoveLlavonImeLicenseFiles" Directory="CM_DP_Runtime.licenses" Name="*" On="uninstall" />
        <RemoveFile Id="RemoveLlavonImeVcpkgLicenseFiles" Directory="CM_DP_Runtime.licenses.vcpkg" Name="*" On="uninstall" />

        <RemoveFolder Id="RemoveLlavonImeTokensFolder" Directory="CM_DP_Runtime.tables.tokens" On="uninstall" />
        <RemoveFolder Id="RemoveLlavonImeVcpkgLicensesFolder" Directory="CM_DP_Runtime.licenses.vcpkg" On="uninstall" />
        <RemoveFolder Id="RemoveLlavonImeBinFolder" Directory="CM_DP_Runtime.bin" On="uninstall" />
        <RemoveFolder Id="RemoveLlavonImeTablesFolder" Directory="CM_DP_Runtime.tables" On="uninstall" />
        <RemoveFolder Id="RemoveLlavonImeLicensesFolder" Directory="CM_DP_Runtime.licenses" On="uninstall" />
        <RemoveFolder Id="RemoveLlavonImeInstallRoot" Directory="INSTALL_ROOT" On="uninstall" />

        <RegistryValue
          Root="HKLM"
          Key="Software\Llavon IME"
          Name="UninstallShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
