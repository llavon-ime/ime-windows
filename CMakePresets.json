{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALL_OPTIONS": "--x-abi-tools-use-exact-versions",
        "LLAVON_IME_ENABLE_CUDA": false
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 TSF frontend",
      "inherits": "windows",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/windows/frontend-x86",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static",
        "LLAVON_IME_FRONTEND_ONLY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "targets": [
        "llavon-ime",
        "frontend-dll-load-tests",
        "frontend-engine-worker-tests",
        "frontend-typing-timing-tests",
        "frontend-key-router-tests",
        "frontend-mapping-layout-tests",
        "pipe-security-tests",
        "pipe-appcontainer-tests"
      ]
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "targets": [
        "llavon-ime-artifacts"
      ]
    },
    {
      "name": "package",
      "configurePreset": "windows",
      "configuration": "Release",
      "targets": [
        "llavon-ime-msi"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-x86",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "filter": {
        "include": { "name": "^(frontend-|pipe-)" }
      },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
