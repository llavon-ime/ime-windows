{
  "name": "llavon-ime-windows",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "cppwinrt",
      "platform": "windows"
    },
    "reflectcpp",
    {
      "name": "utfcpp",
      "platform": "windows"
    }
  ],
  "default-features": [
    "backend",
    "llama-vulkan"
  ],
  "features": {
    "backend": {
      "description": "Build the x64 inference service and its dependencies.",
      "dependencies": [
        { "name": "asio", "platform": "windows" },
        "llama-cpp",
        { "name": "libsodium", "platform": "windows" },
        { "name": "sqlite3", "platform": "windows" },
        { "name": "vulkan-headers", "platform": "windows" }
      ]
    },
    "llama-cuda": {
      "description": "Build llama.cpp with CUDA support for GPU offload.",
      "dependencies": [
        {
          "name": "ggml",
          "features": [
            "cuda"
          ]
        }
      ]
    },
    "llama-vulkan": {
      "description": "Build llama.cpp with Vulkan support for GPU offload.",
      "dependencies": [
        {
          "name": "ggml",
          "features": [
            "vulkan"
          ]
        }
      ]
    }
  }
}
